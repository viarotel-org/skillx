{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/viarotel/skillx/main/schemas/skills-sync-manifest.schema.json",
  "title": "skillx sync manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "sources"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "const": 3
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "location", "branch", "path", "mode", "includes", "excludes", "commit", "status", "targets", "skillPaths", "skills"],
      "properties": {
        "type": {
          "enum": ["local", "remote"]
        },
        "location": {
          "type": "string"
        },
        "branch": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "mode": {
          "enum": ["flat", "nested"]
        },
        "includes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "commit": {
          "type": ["string", "null"]
        },
        "status": {
          "enum": ["synced", "preserved"]
        },
        "targets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skillPaths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/skill"
          }
        }
      }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "relativePath", "contentHash"],
      "properties": {
        "targetId": {
          "type": "string"
        },
        "relativePath": {
          "type": "string"
        },
        "contentHash": {
          "type": "string"
        }
      }
    }
  }
}
